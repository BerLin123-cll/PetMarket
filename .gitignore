# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~

# ---------- 本地配置文件 / 密钥（禁止提交）----------
.env
.env.local
.env.*.local
*-local.yml
*-local.properties
src/main/resources/application-local.yml
src/main/resources/application-local.properties
*.pem
*.key
*.p12
*.jks
secrets/

# ---------- 本地上传的图片/文件（运行时生成，不入库）----------
/data/
/upload/
/uploads/
src/main/resources/static/uploads/

