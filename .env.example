# ============================================================
# PetMarket 环境变量示例文件
#
# 用途：把数据库账号密码、JWT 密钥等敏感配置从代码中剥离，发布前通过环境变量注入。
#
# 重要：本文件只是「示例」，真正的密钥请勿提交到 Git（.gitignore 已忽略 .env）。
#
# ---------- 使用方式 ----------
# 【Windows PowerShell（当前会话生效）】
#   $env:DB_URL="jdbc:mysql://localhost:3306/pet_market?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true"
#   $env:DB_USERNAME="pet_market"
#   $env:DB_PASSWORD="你的数据库密码"
#   $env:JWT_SECRET="你的JWT密钥（至少32字节）"
#   .\mvnw.cmd spring-boot:run
#
# 【Windows CMD】
#   set DB_PASSWORD=你的数据库密码 && set JWT_SECRET=你的密钥 && mvnw.cmd spring-boot:run
#
# 【Linux / macOS】
#   export DB_PASSWORD='...' && export JWT_SECRET='...' && ./mvnw spring-boot:run
#
# 【IDEA】Run/Debug Configurations -> Environment variables 中填入下面变量
# ============================================================

# ---------- 数据库 ----------
# 生产环境请改为实际数据库地址
DB_URL=jdbc:mysql://localhost:3306/pet_market?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=pet_market
DB_PASSWORD=change-me-in-production

# ---------- JWT（发布前必须轮换）----------
# 生成方式（任选其一）：
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#   Linux:      openssl rand -base64 48
# 要求：至少 32 字节，否则应用启动时会报错
JWT_SECRET=please-generate-a-random-secret-at-least-32-bytes
JWT_EXPIRATION=86400000

# ---------- 服务端口 ----------
SERVER_PORT=8081

# ---------- 跨域来源白名单（逗号分隔，不能用 *）----------
# 默认放行 Vite 本地开发地址；生产环境改为真实前端域名，例如 https://shop.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 订单超时自动取消 ----------
# 待支付订单多少分钟后自动取消并回补库存
ORDER_PAY_TIMEOUT_MINUTES=30
# 超时扫描任务执行间隔（毫秒）
ORDER_RELEASE_SCAN_INTERVAL_MS=60000

# ---------- 本地图片上传（暂不做服务器部署，图片只存本机）----------
UPLOAD_DIR=./data/upload
UPLOAD_URL_PREFIX=/uploads
# 单文件大小上限（字节），默认 5MB
UPLOAD_MAX_SIZE=5242880
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=10MB

# ---------- 日志（生产环境）----------
LOG_FILE=./logs/petmarket.log
